{
  "name": "configshell",
  "version": "0.1.0",
  "private": true,
  "description": "ConfigShell \u2014 open-source Linux software discovery and setup-plan generation",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*",
    "tooling/*",
    "skills/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "turbo run dev --filter=web --filter=server --parallel",
    "build": "turbo run build",
    "start": "pnpm --filter server start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "turbo run format",
    "check": "turbo run lint typecheck test build",
    "dev:web": "pnpm --filter web dev",
    "qa:layout": "tsx tooling/scripts/qa-layout.ts",
    "mcp": "pnpm --filter @configshell/mcp start",
    "assets:sync": "tsx tooling/scripts/sync-assets.ts"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "playwright": "^1.64.0",
    "prettier": "3.9.9",
    "tsx": "^4.21.0",
    "turbo": "2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0"
  }
}
