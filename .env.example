# =============================================================================
# configshell — environment template
#
# Everything here is OPTIONAL: every variable has a working default, so the
# stack runs with no .env at all. Copy this file only when you need to change
# something.
#
#   cp .env.example .env && docker compose up -d
#
# Deploying to a container platform (Render, Railway, Vercel, a VPS)? Set these
# in that platform's own environment settings instead of a file — see
# docs/deployment.md.
#
# There are no secrets to configure. ConfigShell has no AI key, no database and
# no auth token, and .env files are git-ignored. Never commit a real one.
# =============================================================================

# The public origin this deployment is reachable at. THE ONE VARIABLE THAT
# USUALLY MATTERS: it is what the public MCP URL is derived from, as
# PUBLIC_BASE_URL + MCP_PATH. Must be https unless it is a localhost origin.
#
#   PUBLIC_BASE_URL=https://configshell.example  ->  https://configshell.example/mcp
#
# Nothing routes on it, so a wrong value misreports that URL rather than
# breaking the server.
PUBLIC_BASE_URL=http://localhost:3000

# Port the server binds inside the container. Hosting platforms set this
# themselves; set it by hand only when running the image directly.
PORT=3000

# Where the MCP endpoint is mounted. Must start with / and must not collide
# with /api or /health. Change it only if something else needs that path.
MCP_PATH=/mcp

# development | test | production. The image already sets production.
NODE_ENV=production

# Docker Compose only: the HOST port the stack is published on.
API_PORT=3000
