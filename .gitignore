# =============================================================================
# configshell — monorepo .gitignore
# Turborepo + pnpm workspaces (apps/*, packages/*)
# Applies from the repository root to every workspace.
# Patterns without a leading slash match at any depth (root, apps/*, packages/*).
# =============================================================================

# -----------------------------------------------------------------------------
# Dependencies
# -----------------------------------------------------------------------------
node_modules/

# -----------------------------------------------------------------------------
# Build & generated output
# -----------------------------------------------------------------------------
dist/
build/
.turbo/
coverage/
.cache/
.vite/
generated/
temp/
tmp/
docs/.qa
# -----------------------------------------------------------------------------
# Environment & secrets
# -----------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
# Keep the checked-in template (matched by .env.* above, so re-include it)

# AI tooling configs (may contain API keys)
opencode.json

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# -----------------------------------------------------------------------------
# OS & editor files
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

.idea/

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# -----------------------------------------------------------------------------
# Tooling caches
# -----------------------------------------------------------------------------
*.tsbuildinfo
.eslintcache

# -----------------------------------------------------------------------------
# Local runtime & debug files
# -----------------------------------------------------------------------------
*.pid
*.seed
*.pid.lock

# -----------------------------------------------------------------------------
# Package-manager artifacts
# This repo is pnpm-only: pnpm-lock.yaml is committed, other lockfiles are not.
# package.json is never ignored by any rule above.
# -----------------------------------------------------------------------------
package-lock.json
yarn.lock
.pnpm-store/
.pnpm-debug.log*

# Generated app and skill asset copies; canonical assets live in packages/assets.
/apps/web/public/logos/
/apps/web/src/design-tokens.css
/skills/linux-catalog/assets/logos/
/skills/linux-catalog/assets/design-tokens.css

# Local media and downloadable skill archives.
/brag-output/
/*.skill.zip

# Turborepo local cache
.turbo
